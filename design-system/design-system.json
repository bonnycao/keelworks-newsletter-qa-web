  "qaPolicy": {
    "enforce": [
      "color variables by identified component role",
      "font family and defined type tokens",
      "link underline",
      "newsletter maximum width",
      "section padding",
      "button styling",
      "image alt attributes",
      "image aspect ratio only when component identity is known",
      "header logo width 180px and issue-date typography/format",
      "browser-view link left alignment, valid edition-specific href and target=_blank"
    ],
    "reviewOnly": [
      "Figma frame heights are design reference, not fixed responsive requirements",
      "dark-mode appearance in email clients",
      "unidentified section background variant",
      "image subject matter and copy",
      "component visual equivalence"
    ],
    "platforms": {
      "email": "light-mode email markup; inline critical CSS; presentation tables",
      "web": "light and dark themes"
    }
  },
