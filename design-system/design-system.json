    "qaNotes": [
      "Check accessible link name",
      "Check actual href",
      "Check CSS properties and decorative icon",
      "Do not require button screenshot pixel match"
    ]
  },
  "linkValidation": {
    "category": "Links & Redirect Validation",
    "scope": "All newsletter a[href] elements including browser, content, CTA, social, and footer links",
    "checks": [
      {
        "id": "LINK-01",
        "name": "Missing or empty href",
        "severity": "High",
        "condition": "href missing, empty, whitespace-only, or # without valid in-page target"
      },
      {
        "id": "LINK-02",
        "name": "Invalid URL or unsafe protocol",
        "severity": "High",
        "condition": "Malformed URL or unsupported scheme (javascript:, data:, etc.)"
      },
      {
        "id": "LINK-03",
        "name": "Broken HTTP destination",
        "severity": "High",
        "condition": "Final HTTP status 404 or 410"
      },
      {
        "id": "LINK-04",
        "name": "Server error",
        "severity": "High",
        "condition": "Final HTTP status 500–599"
      },
      {
        "id": "LINK-05",
        "name": "Redirect failure",
        "severity": "High",
        "condition": "Redirect loop, missing Location, invalid target, or max redirects exceeded"
      },
      {
        "id": "LINK-06",
        "name": "Approved URL mismatch",
        "severity": "High",
        "condition": "Recognized component destination does not match approved URL mapping"
      },
      {
        "id": "LINK-07",
        "name": "Missing accessible link name",
        "severity": "Medium",
        "condition": "Link has no visible text, image alt, or aria-label"
      },
      {
        "id": "LINK-08",
        "name": "Timeout, 403, 429, or bot protection",
        "severity": "Needs review",
        "condition": "Inconclusive automated response"
      },
      {
        "id": "LINK-09",
        "name": "Successful redirect",
        "severity": "Info",
        "condition": "HTTP 301,302,303,307,308 ending in successful 2xx response; capture final URL and redirect chain"
      },
      {
        "id": "LINK-10",
        "name": "Email, telephone, and fragment links",
        "severity": "Needs review",
        "condition": "Validate mailto syntax, tel syntax, and fragment target locally; do not send HTTP requests"
      }
    ],
    "httpMethod": "GET with redirect following; HEAD may be attempted as optimization but must not be the sole check",
    "maxRedirects": 10,
    "timeoutMs": 10000,
    "security": "Block private/local/internal network targets and unsafe schemes to avoid SSRF; do not execute JavaScript URLs",
    "resultsFields": [
      "sourceElement",
      "linkText",
      "originalHref",
      "resolvedUrl",
      "redirectChain",
      "finalUrl",
      "httpStatus",
      "outcome",
      "severity",
      "issueId"
    ],
    "deduplicateRequestsByResolvedUrl": true
  },
